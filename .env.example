# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne jamais committer le fichier ".env" reel sur GitHub.

# Port du serveur (Render/Railway le definissent automatiquement en production)
PORT=3000

# Compte email utilise pour ENVOYER les notifications (ex: un compte Gmail dedie)
# Pour Gmail : activez la validation en 2 etapes puis creez un "mot de passe d'application"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-compte@gmail.com
SMTP_PASS=votre-mot-de-passe-application

# Adresse qui RECOIT les notifications de leads/inscriptions
CONTACT_EMAIL=support@essor-ia.com

# Lien Calendly pour reserver un appel. Laissez vide tant qu'il n'existe pas :
# le bouton "Reserver un appel" redirigera automatiquement vers WhatsApp en attendant.
CALENDLY_URL=

# Paiement en ligne (PayPal Checkout : cartes bancaires + compte PayPal).
# Necessite un compte PayPal BUSINESS (gratuit, upgrade en 2 min depuis un compte Personal).
# Recuperez ces identifiants sur https://developer.paypal.com (Apps & Credentials).
# Laissez vides tant que non configure : le bouton "Payer maintenant" affichera un message
# "paiement indisponible" au lieu de planter le site.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox = tests, live = paiements reels
PAYPAL_MODE=sandbox

# Tracking / mesure d'audience (tout est optionnel : tant qu'une variable est vide,
# le script correspondant n'est jamais charge sur le site, meme apres consentement cookies).
# Google Tag Manager - ID du conteneur (ex: GTM-XXXXXXX)
GTM_ID=
# Google Analytics 4 - ID de mesure (ex: G-XXXXXXXXXX). Inutile si GA4 est deja configure via GTM.
GA4_ID=
# Meta (Facebook/Instagram) Pixel - ID du pixel
META_PIXEL_ID=
# LinkedIn Insight Tag - Partner ID
LINKEDIN_PARTNER_ID=
# Pinterest Tag - Tag ID
PINTEREST_TAG_ID=
